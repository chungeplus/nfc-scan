{
  "name": "@nfc-scan/miniprogram",
  "private": true,
  "scripts": {
    "lint": "eslint \"app.ts\" \"components/**/*.ts\" \"custom-tab-bar/**/*.ts\" \"pages/**/*.ts\" \"utils/**/*.ts\"",
    "lint:fix": "eslint --fix \"app.ts\" \"components/**/*.ts\" \"custom-tab-bar/**/*.ts\" \"pages/**/*.ts\" \"utils/**/*.ts\"",
    "lint:styles": "stylelint \"./**/*.scss\"",
