<pixel-navbar title="写入本地音视频" theme="audio" showBack="{{true}}" showHome="{{false}}" />
<pixel-toast id="pixel-toast" />

<view class="write-media motion-fade" style="min-height: calc(100vh - {{navHeight}}px);">
    <view wx:if="{{submitting}}" class="loading-overlay motion-fade" style="padding-top: {{navHeight}}px;">
        <view class="loading-overlay__content motion-pop">
            <view class="loading-overlay__spinner"></view>
            <view class="loading-overlay__title">{{submittingText}}</view>
        </view>
    </view>

    <view class="field motion-enter motion-enter--1">
        <button class="picker-btn motion-pressable" bindtap="handleChooseFile" disabled="{{submitting}}">从微信会话选择文件</button>

        <view wx:if="{{selectedFileName}}" class="upload-card">
            <view class="upload-card__name">{{selectedFileName}}</view>
            <view class="pill-row">
                <view class="pill">{{selectedFileSizeText}}</view>
                <view class="pill">{{selectedFileTagText}}</view>
            </view>
        </view>
    </view>

    <view wx:if="{{errorMessage}}" class="inline-error">{{errorMessage}}</view>

    <view class="field motion-enter motion-enter--2">
        <view class="label">播放页风格</view>
        <view class="theme-grid">
            <button
                wx:for="{{themeOptions}}"
                wx:key="key"
                class="theme-btn motion-pressable {{themeKey === item.key ? 'theme-btn--active' : ''}}"
                data-key="{{item.key}}"
                bindtap="handleSelectTheme"
            >
                {{item.label}}
            </button>
        </view>
    </view>

    <button
        class="primary-btn motion-enter motion-enter--3 motion-pressable"
        disabled="{{submitting || !canSubmitMedia}}"
        bindtap="handleWriteMedia"
    >
        <text wx:if="{{submitting}}">{{submittingText}}</text>
        <text wx:else>{{primaryButtonText}}</text>
    </button>
</view>

<button class="fab motion-pop motion-enter--4 motion-idle-float" open-type="contact">
    <pixel-icon name="question" size="44" />
</button>

<scan-dialog
    visible="{{scanVisible}}"
    records="{{records}}"
    successMessage="播放页链接写入完成"
    successSubMessage="可以继续写入，或回到我的文件继续管理"
    successPrimaryText="继续写入"
    successSecondaryText="回我的文件"
    bind:close="handleCloseScanDialog"
    bind:secondaryaction="handleGoToFiles"
/>
