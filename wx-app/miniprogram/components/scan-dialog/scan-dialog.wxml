<view wx:if="{{visible}}" class="overlay">
    <view class="dialog">
        <view class="dialog__title dialog__title--{{scanStatus}}">
            <text wx:if="{{scanStatus === 'waiting'}}">等待贴近标签</text>
            <text wx:elif="{{scanStatus === 'writing'}}">写入中</text>
            <text wx:elif="{{scanStatus === 'success'}}">写入成功</text>
            <text wx:elif="{{scanStatus === 'error'}}">操作失败</text>
        </view>

        <view class="dialog__body">
            <view class="stage stage--{{scanStatus}}">
                <view wx:if="{{scanStatus === 'waiting'}}" class="stage__waiting">
                    <view class="stage__waiting-scene">
                        <view class="stage__phone-shell">
                            <view class="nphone">
                                <pixel-icon name="phone" size="64" />
                            </view>
                            <view class="stage__phone-halo"></view>
                        </view>
                        <view class="stage__beam motion-scan-loop"></view>
                        <view class="ntag">
                            <pixel-icon name="nfc" size="32" />
                            <text>NFC</text>
                        </view>
                    </view>
                    <view class="hint hint--center">请将 NFC 标签贴近手机感应区</view>
                </view>

                <view wx:elif="{{scanStatus === 'writing'}}" class="stage__writing">
                    <view class="stage__process-core motion-scan-processing"></view>
                    <view class="hint hint--center hint--green">正在写入，请勿移动标签</view>
                </view>

                <view wx:elif="{{scanStatus === 'success'}}" class="stage__result">
                    <view class="stage__icon-wrap motion-scan-complete">
                        <pixel-icon name="check" size="64" />
                    </view>
                    <view class="hint hint--center hint--green">{{successMessage}}</view>
                    <view class="hint hint--center hint--green">{{successSubMessage}}</view>
                </view>

                <view wx:else class="stage__result">
                    <view class="stage__icon-wrap motion-scan-alert">
                        <pixel-icon name="error" size="64" />
                    </view>
                    <view class="hint hint--center hint--red" wx:if="{{errorMessage}}">{{errorMessage}}</view>
                    <view class="hint hint--center hint--red" wx:if="{{!errorMessage}}">标签可能已损坏或容量不足，请更换标签后重试</view>
                </view>
            </view>
        </view>

        <view class="dialog__actions dialog__actions--one" wx:if="{{scanStatus === 'waiting' || scanStatus === 'writing'}}">
            <button class="dialog-btn" bindtap="handleCancel">取消</button>
        </view>

        <view
            class="dialog__actions {{successSecondaryText ? 'dialog__actions--two' : 'dialog__actions--one'}}"
            wx:if="{{scanStatus === 'success'}}"
        >
            <button class="dialog-btn" bindtap="handlePrimaryAction">{{successPrimaryText}}</button>
            <button
                wx:if="{{successSecondaryText}}"
                class="dialog-btn dialog-btn--green"
                bindtap="handleSecondaryAction"
            >
                {{successSecondaryText}}
            </button>
        </view>

        <view class="dialog__actions dialog__actions--two" wx:if="{{scanStatus === 'error'}}">
            <button class="dialog-btn dialog-btn--red" bindtap="handleRetry">重试</button>
            <button class="dialog-btn dialog-btn--green" bindtap="handlePrimaryAction">确定</button>
        </view>
    </view>
</view>
