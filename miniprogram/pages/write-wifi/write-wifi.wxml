<pixel-navbar title="写入 WLAN" theme="web" showBack="{{true}}" showHome="{{false}}" />

<view class="write-wifi" style="min-height: calc(100vh - {{navHeight}}px);">
    <view class="support-chip">{{pageHint}}</view>
    <view class="status-banner status-banner--{{statusTone}}" wx:if="{{statusMessage}}">
        {{statusMessage}}
    </view>

    <view class="field">
        <view class="field__head">
            <view class="label">当前网络</view>
            <view class="selection-pill" wx:if="{{selectedSsid}}">{{selectedSsid}}</view>
        </view>

        <view
            wx:if="{{currentWifi && currentWifi.SSID}}"
            class="wifi-card {{selectedSsid === currentWifi.SSID ? 'wifi-card--active' : ''}}"
            bindtap="handleSelectCurrentWifi"
        >
            <view class="wifi-card__head">
                <view class="wifi-name">{{currentWifi.SSID}}</view>
                <view class="wifi-tag">当前</view>
            </view>
        </view>

        <view class="hint" wx:elif="{{loadingCurrentWifi}}">读取当前连接中...</view>
        <view class="hint" wx:else>未读取到当前连接，可改为扫描附近网络</view>
    </view>

    <view class="field">
        <view class="field__head">
            <view class="label">附近网络</view>
        </view>

        <button class="btn btn--scan" bindtap="handleScanNearbyWifi" loading="{{scanningNearbyWifi}}">
            扫描附近网络
        </button>

        <scroll-view class="wifi-list" scroll-y="{{true}}" wx:if="{{nearbyWifiList.length}}">
            <view
                wx:for="{{nearbyWifiList}}"
                wx:key="SSID"
                class="wifi-list__item {{selectedSsid === item.SSID ? 'wifi-list__item--active' : ''}}"
                data-ssid="{{item.SSID}}"
                bindtap="handleSelectNearbyWifi"
            >
                <view class="wifi-card__head">
                    <view class="wifi-name">{{item.SSID}}</view>
                    <view class="wifi-signal">信号 {{item.signalStrength}}</view>
                </view>
            </view>
        </scroll-view>
    </view>

    <view class="field">
        <view class="field__head">
            <view class="label">密码</view>
        </view>
        <input
            class="box"
            password="{{true}}"
            value="{{wifiPassword}}"
            placeholder="输入 WLAN 密码"
            bindinput="handlePasswordInput"
        />
    </view>

    <button
        class="primary-btn"
        disabled="{{!selectedSsid || !wifiPassword}}"
        bindtap="handleOpenScanDialog"
    >
        写入 NFC 标签
    </button>
</view>

<scan-dialog visible="{{scanVisible}}" records="{{records}}" bind:close="handleCloseScanDialog" />
